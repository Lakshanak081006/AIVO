APP_NAME=Autonomous Personal Assistant
APP_VERSION=16.0.0
APP_ENV=development
DEBUG=false
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api

# Zero-setup local option
DATABASE_URL=sqlite:///./assistant.db
AUTO_CREATE_DB=true

# PostgreSQL example
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/autonomous_assistant

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173,http://10.143.170.1:5173

LLM_PROVIDER=none
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

MAX_TOOL_RETRIES=3
RETRY_BASE_DELAY_SECONDS=0.1
DEMONSTRATION_MODE=true
LOG_LEVEL=INFO

DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=Demo@12345
DEMO_USER_NAME=Demo User

# Lyzr Studio integration
LYZR_ENABLED=false
LYZR_API_KEY=
LYZR_AGENT_ID=6a645e3294689fab2dee8010
LYZR_BASE_URL=https://agent-prod.studio.lyzr.ai
LYZR_CHAT_ENDPOINT=/v3/inference/chat/
LYZR_TIMEOUT_SECONDS=60
